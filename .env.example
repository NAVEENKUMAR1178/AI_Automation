# ---- AI (all free tiers) ----
# Caption: Google Gemini free key from https://aistudio.google.com/apikey  (leave empty to use Pollinations text, no key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Image: Pollinations.ai needs no key. Optional Hugging Face token as 2nd option:
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ---- WhatsApp (WAHA, runs in Docker; use a SECONDARY number) ----
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=change-me-secret
WAHA_SESSION=default

# ---- Schedule ----
TZ=Asia/Kolkata
POST_HOUR=9
POST_MINUTE=0

# ---- Brand ----
BRAND_NAME=DealerKart
